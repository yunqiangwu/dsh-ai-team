{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "outDir": "lib/types",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true
  },
  // view.ts 是类型门面：值依赖 vocab.ts（零依赖、浏览器安全），类型依赖
  // schema.ts（只有 `export type { ... } from`，zod 不会进客户端产物）。
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "src/view.ts",
    "src/vocab.ts",
    "src/schema.ts"
  ],
  "exclude": ["node_modules", "lib", "tests"]
}
