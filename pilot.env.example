# 试点所需环境变量（复制为 pilot.env 或注入 systemd EnvironmentFile / shell profile）。
# 只定义名字：值自己填，本文件与 pilot.patch.yml 永远不出现密钥明文。
# 注意：这些是 dsh 进程本身的环境变量，与 bootstrap.envFile 生成的目标仓库 .env 无关。

# deploy key 私钥内容（ssh-ed25519 开头、对目标仓库可读写）或 https token
AUTOPILOT_GIT_KEY=

# GitHub personal access token（repo 权限：PR upsert + CI 状态读取）
GITHUB_TOKEN=

# 可选：升级即时通知 webhook（钉钉/飞书/自建）
AUTOPILOT_WEBHOOK=

# 可选：人工确认邮件（开启 notification 时必需）
AUTOPILOT_SMTP_USER=
AUTOPILOT_SMTP_PASS=
AUTOPILOT_SMTP_FROM=
